---
import App from '../components/App';
import Layout from '../layouts/Layout.astro';
import { findGalleryProfile } from '../lib/gallery';
import {
  getProfileScan,
  isGalleryLogin,
  PROFILE_CACHE_CONTROL,
} from '../lib/profileCache';
import type { GitHubUser, ScanResult } from '../lib/types';

const rawUsername = decodeURIComponent(Astro.params.username ?? '').trim();
const isValidUsername = /^[a-z\d](?:[a-z\d]|-(?=[a-z\d])){0,38}$/i.test(rawUsername);

let user: Pick<GitHubUser, 'login' | 'name' | 'bio' | 'avatar_url' | 'html_url'> | null = null;
let initialResult: ScanResult | null = null;

if (!isValidUsername) {
  Astro.response.status = 404;
} else if (isGalleryLogin(rawUsername)) {
  // Curated profile: render the finished scan, cached on the CDN
  try {
    initialResult = await getProfileScan(rawUsername);
    user = initialResult.user;
    Astro.response.headers.set('Cache-Control', PROFILE_CACHE_CONTROL);
  } catch {
    // Fall back to a client-side scan with default metadata
  }
} else {
  try {
    const token = import.meta.env.GITHUB_TOKEN;
    const response = await fetch(`https://api.github.com/users/${rawUsername}`, {
      headers: {
        Accept: 'application/vnd.github+json',
        'User-Agent': 'hiring-github-profile',
        ...(token ? { Authorization: `Bearer ${token}` } : {}),
      },
    });

    if (response.ok) {
      user = (await response.json()) as GitHubUser;
      // Only metadata comes from the server here; an hour is plenty
      Astro.response.headers.set(
        'Cache-Control',
        'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400',
      );
    } else if (response.status === 404) {
      Astro.response.status = 404;
    }
  } catch {
    // Keep default SEO metadata if GitHub API is unavailable.
  }
}

const displayName = user?.name?.trim() || user?.login || rawUsername;
const topSkills = (initialResult?.categories ?? [])
  .flatMap((c) => c.skills.slice(0, c.id === 'languages' ? 4 : 2))
  .slice(0, 8)
  .map((s) => s.name);
const title = topSkills.length
  ? `${displayName} tech stack: ${topSkills.slice(0, 3).join(', ')} | GitHub Skills Scanner`
  : `${displayName} - GitHub Skills Scanner`;

const intro = user?.bio?.trim() ? `${displayName}: ${user.bio.trim()}.` : `${displayName} on GitHub.`;
const description = topSkills.length
  ? `${intro} Skills detected from ${initialResult!.totalRepos} public repositories: ${topSkills.join(', ')}. Generate a recruiter-ready README.`
  : `Open ${displayName} in Hiring GitHub Profile to scan public repositories and generate a recruiter-ready skills summary. Analyze languages, frameworks, and tooling from public repositories.`;

const gallery = findGalleryProfile(rawUsername);
const profileData = user
  ? {
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      name: title,
      url: new URL(Astro.url.pathname, Astro.site).toString(),
      mainEntity: {
        '@type': 'Person',
        name: displayName,
        alternateName: user.login,
        description: user.bio ?? gallery?.tagline,
        image: user.avatar_url,
        url: user.html_url,
        sameAs: [user.html_url, gallery?.youtube?.url, gallery?.link?.url].filter(Boolean),
        ...(topSkills.length ? { knowsAbout: topSkills } : {}),
      },
    }
  : undefined;
---

<Layout title={title} description={description} structuredData={profileData}>
  <script is:inline>
    const bodyElement = document.querySelector('body');
    window.__BASE_URL__ = bodyElement?.getAttribute('data-base-url') || '/';
  </script>
  <App client:idle initialResult={initialResult} />
</Layout>
